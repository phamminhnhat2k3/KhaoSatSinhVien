generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  LECTURER
  ADMIN
  DEAN
}

enum QuestionType {
  SINGLE
  MULTIPLE
  SCALE
  TEXT
}

enum CampaignStatus {
  DRAFT
  PUBLISHED
  CLOSED
  CANCELLED
}

enum ParticipationStatus {
  INVITED
  DRAFT
  COMPLETED
}

enum SurveyScope {
  LEGACY_CLASS
  FACULTY
  UNIVERSITY
}

model Faculty {
  lecturers LecturerProfile[]
  courses Course[]
  id String @id @default(cuid())
  code String @unique
  name String
  classes AcademicClass[]
  campaigns SurveyCampaign[]
}

model AcademicClass {
  studyAssignments ClassStudyAssignment[]
  campaignTargets CampaignAcademicClass[]
  id String @id @default(cuid())
  code String @unique
  name String
  facultyId String
  faculty Faculty @relation(fields: [facultyId], references: [id])
  students StudentProfile[]
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String
  name         String
  active       Boolean @default(true)
  phone        String @default("")
  department   String @default("")
  bio          String @default(dbgenerated("(_utf8mb4\\'\\')")) @db.Text
  coverTheme   String @default("blue")
  notifications Notification[]
  roles        UserRole[]
  student      StudentProfile?
  lecturer     LecturerProfile?
  auditLogs    AuditLog[]
}

model UserRole {
  userId String
  role   Role
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([userId, role])
}

model StudentProfile {
  studyPlans StudentStudyPlan[]
  id            String @id @default(cuid())
  studentCode   String @unique
  userId        String @unique
  academicClassId String?
  academicClass AcademicClass? @relation(fields: [academicClassId], references: [id])
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  enrollments   Enrollment[]
  participations SurveyParticipation[]
}

model LecturerProfile {
  teachings CourseTeaching[]
  evaluations ParticipationTeaching[]
  answers Answer[]
  facultyId String?
  faculty Faculty? @relation(fields: [facultyId], references: [id])
  courses Course[]
  id          String @id @default(cuid())
  lecturerCode String @unique
  userId      String @unique
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  classes     CourseClass[]
}

model Semester {
  studentStudyPlans StudentStudyPlan[]
  id        String @id @default(cuid())
  name      String
  startsAt  DateTime
  endsAt    DateTime
  classes   CourseClass[]
  campaigns SurveyCampaign[]
}

model Course {
  teachingEvaluations ParticipationTeaching[]
  facultyId String?
  faculty Faculty? @relation(fields: [facultyId], references: [id])
  lecturers LecturerProfile[]
  id      String @id @default(cuid())
  code    String @unique
  name    String
  classes CourseClass[]
  campaignTargets CampaignCourse[]
  assignments ParticipationCourse[]
  answers Answer[]
}

model CourseClass {
  academicAssignments ClassStudyAssignment[]
  teachingConfigured Boolean @default(false)
  teachings CourseTeaching[]
  educationSystem String @default("REGULAR")
  capacity Int @default(50)
  id          String @id @default(cuid())
  code        String @unique
  courseId    String
  semesterId  String
  lecturerId  String?
  course      Course @relation(fields: [courseId], references: [id])
  semester    Semester @relation(fields: [semesterId], references: [id])
  lecturer    LecturerProfile? @relation(fields: [lecturerId], references: [id], onDelete: Restrict)
  enrollments Enrollment[]
  targets     SurveyTarget[]
}

model Enrollment {
  classId   String
  studentId String
  class     CourseClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@id([classId, studentId])
}

model SurveyTemplate {
  id        String @id @default(cuid())
  title     String
  version   Int @default(1)
  createdAt DateTime @default(now())
  questions Question[]
  campaigns SurveyCampaign[] @relation("CommonTemplate")
  courseCampaigns SurveyCampaign[] @relation("CourseTemplate")
}

model Question {
  id         String @id @default(cuid())
  templateId String
  content    String @db.Text
  type       QuestionType
  required   Boolean @default(true)
  position   Int
  scaleMin   Int @default(1)
  scaleMax   Int @default(5)
  scaleStep  Int @default(1)
  template   SurveyTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  options    QuestionOption[]
  answers    Answer[]
  @@unique([templateId, position])
}

model QuestionOption {
  id         String @id @default(cuid())
  questionId String
  label      String @db.VarChar(200)
  value      String
  position   Int
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
}

model SurveyCampaign {
  academicTargets CampaignAcademicClass[]
  evaluationMode String @default("COURSE")
  approvedAt DateTime?
  approvedBy String?
  reviewNote String? @db.Text
  id          String @id @default(cuid())
  title       String
  templateId  String
  scope SurveyScope @default(LEGACY_CLASS)
  facultyId String?
  semesterId String?
  courseTemplateId String?
  faculty Faculty? @relation(fields: [facultyId], references: [id], onDelete: Restrict)
  semester Semester? @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  courseTemplate SurveyTemplate? @relation("CourseTemplate", fields: [courseTemplateId], references: [id], onDelete: Restrict)
  courseTargets CampaignCourse[]
  status      CampaignStatus @default(DRAFT)
  startsAt    DateTime
  endsAt      DateTime
  createdAt   DateTime @default(now())
  publishedAt DateTime?
  template    SurveyTemplate @relation("CommonTemplate", fields: [templateId], references: [id])
  targets     SurveyTarget[]
  participations SurveyParticipation[]
  submissions Submission[]
}

model SurveyTarget {
  campaignId String
  classId    String
  campaign   SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  class      CourseClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  @@id([campaignId, classId])
}

model SurveyParticipation {
  teachings ParticipationTeaching[]
  id          String @id @default(cuid())
  campaignId  String
  studentId   String
  status      ParticipationStatus @default(INVITED)
  draft       Json?
  completedAt DateTime?
  courses ParticipationCourse[]
  campaign    SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  @@unique([campaignId, studentId])
}

model Submission {
  id         String @id @default(cuid())
  campaignId String
  submittedAt DateTime @default(now())
  campaign   SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  answers    Answer[]
}

model Answer {
  lecturerId String?
  lecturer LecturerProfile? @relation(fields:[lecturerId],references:[id],onDelete:Restrict)
  id           String @id @default(cuid())
  submissionId String
  questionId   String
  courseId String?
  course Course? @relation(fields: [courseId], references: [id], onDelete: Restrict)
  value        Json
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question     Question @relation(fields: [questionId], references: [id])
}

model CampaignCourse {
  campaignId String
  courseId String
  campaign SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id])
  @@id([campaignId, courseId])
}

model ParticipationCourse {
  participationId String
  courseId String
  participation SurveyParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id])
  @@id([participationId, courseId])
}

model CourseTeaching {
  classId String
  lecturerId String
  class CourseClass @relation(fields:[classId],references:[id],onDelete:Cascade)
  lecturer LecturerProfile @relation(fields:[lecturerId],references:[id],onDelete:Restrict)
  @@id([classId,lecturerId])
}

model ParticipationTeaching {
  participationId String
  courseId String
  lecturerId String
  participation SurveyParticipation @relation(fields:[participationId],references:[id],onDelete:Cascade)
  course Course @relation(fields:[courseId],references:[id],onDelete:Restrict)
  lecturer LecturerProfile @relation(fields:[lecturerId],references:[id],onDelete:Restrict)
  @@id([participationId,courseId,lecturerId])
}

model ClassStudyAssignment {
  academicClassId String
  classId String
  academicClass AcademicClass @relation(fields: [academicClassId], references: [id], onDelete: Cascade)
  class CourseClass @relation(fields: [classId], references: [id], onDelete: Cascade)
  @@id([academicClassId, classId])
}

model StudentStudyPlan {
  studentId String
  semesterId String
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  semester Semester @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  @@id([studentId, semesterId])
}

model CampaignAcademicClass {
  campaignId String
  academicClassId String
  campaign SurveyCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  academicClass AcademicClass @relation(fields: [academicClassId], references: [id], onDelete: Restrict)
  @@id([campaignId, academicClassId])
}

model AuditLog {
  id        String @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String
  createdAt DateTime @default(now())
  actor     User @relation(fields: [actorId], references: [id])
}

model Notification {
  id        String @id @default(cuid())
  userId    String
  title     String
  body      String @db.Text
  href      String
  createdAt DateTime @default(now())
  readAt    DateTime?
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, readAt, createdAt])
}
