{
  "name": "khao-sat-sinh-vien",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.13.0" },
  "scripts": {
    "dev": "next dev --port 3005",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run src/modules/response/response.integration.test.ts",
    "test:e2e": "playwright test",
    "test:e2e:isolated": "node scripts/run-feature-tests.mjs",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:admin": "node --env-file=.env --import tsx prisma/create-admin.ts",
    "db:check": "prisma migrate status",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "db:demo": "node --env-file=.env --import tsx prisma/demo.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:integration && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "1.1.1",
    "@prisma/client": "6.12.0",
    "argon2": "0.44.0",
    "exceljs": "4.4.0",
    "fflate": "0.8.3",
    "next": "15.5.28",
    "next-auth": "5.0.0-beta.32",
    "nodemailer": "10.5.0",
    "pdf-lib": "1.17.1",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.1.14",
    "@types/node": "22.18.12",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@typescript-eslint/eslint-plugin": "8.46.2",
    "@typescript-eslint/parser": "8.46.2",
    "eslint": "8.57.1",
    "postcss": "8.5.23",
    "prisma": "6.12.0",
    "tailwindcss": "4.1.14",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "prisma": {
    "seed": "node --env-file=.env --import tsx prisma/seed.ts"
  }
}
