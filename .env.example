# Copy this file to .env on the server and replace every placeholder.
# Never commit .env or use these placeholders in production.

# Local Windows development (MySQL installed on this machine)
DATABASE_URL="mysql://root:YOUR_URL_ENCODED_MYSQL_PASSWORD@127.0.0.1:3306/student_survey"

# Docker Compose deployment (the database service is named `db`)
DATABASE_URL_DOCKER="mysql://surveyapp:YOUR_URL_ENCODED_MYSQL_PASSWORD@db:3306/student_survey"
MYSQL_ROOT_PASSWORD="CHANGE_THIS_ROOT_PASSWORD"
MYSQL_DATABASE="student_survey"
MYSQL_USER="surveyapp"
MYSQL_PASSWORD="CHANGE_THIS_APP_PASSWORD"

# Application
AUTH_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
APP_URL="http://localhost:3005"
PORT="3005"
MIN_REPORT_RESPONSES="5"

# Optional Gmail password reset mail
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
